{
  "name": "@openmasq/schema",
  "version": "0.1.0",
  "description": "Canonical persisted chat schema (roles, messages, conversations, redaction categories) — types only, zero runtime, so clients cannot drift.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@openmasq/redact": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
