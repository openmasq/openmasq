{
  "name": "tesseract2.js",
  "version": "1.0.0",
  "private": true,
  "description": "Isomorphic multilingual OCR (Node worker_threads + browser/MV3 Web Worker) — a hardened TypeScript rewrite of tesseract.js over the tesseract.js-core WASM. Vendored into the monorepo; the desktop uses the Node build, the extension the browser build.",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "node": { "types": "./dist/node/index.d.ts", "default": "./dist/node/index.js" },
      "browser": { "types": "./dist/node/index.d.ts", "default": "./dist/browser/index.js" },
      "default": { "types": "./dist/node/index.d.ts", "default": "./dist/node/index.js" }
    },
    "./node": { "types": "./dist/node/index.d.ts", "default": "./dist/node/index.js" },
    "./browser": { "types": "./dist/node/index.d.ts", "default": "./dist/browser/index.js" }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node scripts/build-browser.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "tesseract.js-core": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "license": "Apache-2.0"
}
