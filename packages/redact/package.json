{
  "name": "@openmasq/redact",
  "version": "0.2.0",
  "description": "Reversible PII redaction for LLM prompts: detect sensitive data, replace it with realistic fakes, restore the reply from a vault. Offline, TypeScript.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmasq/openmasq.git",
    "directory": "packages/redact"
  },
  "homepage": "https://openmasq.com/redact",
  "bugs": "https://github.com/openmasq/openmasq/issues",
  "keywords": [
    "pii",
    "pii-detection",
    "pii-redaction",
    "redaction",
    "pseudonymization",
    "anonymization",
    "data-masking",
    "dlp",
    "presidio",
    "presidio-alternative",
    "llm",
    "llm-security",
    "prompt",
    "privacy",
    "gdpr",
    "ner",
    "openai",
    "anthropic"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./documents": {
      "types": "./dist/documents/documents.d.ts",
      "import": "./dist/documents/documents.js",
      "require": "./dist/documents/documents.cjs"
    },
    "./documents.browser": {
      "types": "./dist/documents/browser.d.ts",
      "import": "./dist/documents/browser.js",
      "require": "./dist/documents/browser.cjs"
    },
    "./pdf-redact": {
      "types": "./dist/viewer/pdfRedact.d.ts",
      "import": "./dist/viewer/pdfRedact.js",
      "require": "./dist/viewer/pdfRedact.cjs"
    },
    "./image-redact": {
      "types": "./dist/viewer/imageRedact.d.ts",
      "import": "./dist/viewer/imageRedact.js",
      "require": "./dist/viewer/imageRedact.cjs"
    },
    "./inplace": {
      "types": "./dist/documents/inplace.d.ts",
      "import": "./dist/documents/inplace.js",
      "require": "./dist/documents/inplace.cjs"
    },
    "./remote": {
      "types": "./dist/remote/remote.d.ts",
      "import": "./dist/remote/remote.js",
      "require": "./dist/remote/remote.cjs"
    },
    "./ner": {
      "types": "./dist/local/ner.d.ts",
      "import": "./dist/local/ner.js",
      "require": "./dist/local/ner.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bench.json --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "clean": "rm -rf dist .turbo",
    "prepack": "REDACT_PUBLISH=1 tsup && cp ../../LICENSE ../../NOTICE .",
    "postpack": "rm -f LICENSE NOTICE && tsup"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "libphonenumber-js": "^1.13.12"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@openmasq/branding": "workspace:*",
    "mammoth": "^1.12.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract2.js": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "xlsx": "workspace:*"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "xlsx": ">=0.20.3"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  }
}
