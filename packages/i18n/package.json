{
  "name": "@openmasq/i18n",
  "version": "0.1.0",
  "description": "Typed message catalogue, French source and English side by side — no React, no library; importable from the renderer, the main process and servers.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  }
}
