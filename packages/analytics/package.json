{
  "name": "@openmasq/analytics",
  "version": "0.1.0",
  "description": "Privacy-safe usage analytics core: allow-listed event sanitising, a double consent gate, and the relay envelope — zero dependencies, manual events only.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@openmasq/branding": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
