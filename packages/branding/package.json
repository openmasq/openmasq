{
  "name": "@openmasq/branding",
  "version": "0.1.0",
  "description": "The one home of the brand (branding.json): name, domains, URL scheme, storage keys — every runtime, wire and disk value derives from it.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./branding.json": "./branding.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  }
}
