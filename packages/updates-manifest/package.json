{
  "name": "@openmasq/updates-manifest",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Le format des manifestes de mise à jour du bureau — UNE maison, partagée par le producteur (apps/desktop) et le serveur du flux (apps/updates, dépôt infra).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\"",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openmasq/branding": "workspace:*"
  }
}
