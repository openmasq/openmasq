# The bare minimum — Biome (biome.json) is the source of truth for style; this only
# covers what an editor decides BEFORE any formatter (line endings, indentation of the
# formats Biome does not format: yaml, md, css).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
