# Le strict minimum — Biome (biome.json) est la source de vérité du style ; ceci ne
# couvre que ce qu'un éditeur décide AVANT tout formateur (fins de ligne, indentation
# des formats que Biome ne formate pas : yaml, md, css).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
