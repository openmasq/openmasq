#!/bin/sh
# Pre-commit: the FAST gates, scoped to what THIS commit stages — never the WIP of the
# other sessions in the tree (see scripts/check-staged-loc.mjs). CI keeps the full gates.
# Bypass knowingly: `git commit --no-verify`.
set -e

# ⛔ NO identity guard here, and that is deliberate. A hard-coded allow-list of addresses
# rejected the commit of ANYONE who was not one of the two maintainers — on a public
# repository that means every contributor, on their first commit, with a message inviting
# them to pass themselves off as the team. Deployment does not depend on the author
# either: `.github/scripts/vercel-deploy.sh` normalizes the deployed commit's author in
# CI's EPHEMERAL checkout. So there was nothing left to guard — only two personal
# addresses published and a door closed to contributions.
# Everyone commits under THEIR identity; that is what history must state.

# (Blocking direct commits on staging/main was removed along with the worktree
# convention: the shared tree IS now where every session works, and staging receives
# their direct commits. The remaining discipline is in the root CLAUDE.md: commit only
# YOUR files, gates green before pushing.)

node scripts/check-staged-loc.mjs

# Lint (Biome) on the STAGED files only — like the LOC cap above, we look at what THIS
# commit brings, never at the other sessions' WIP. We LINT (no format check): a
# retroactive format would inflate the dense existing code past the 300-line cap
# (rule 1). Format stays available (`pnpm format`, Biome config for the editor) and
# applies to new code; it is not gated here. Bypassing a lint: --no-verify.
STAGED_CODE=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)
if [ -n "$STAGED_CODE" ]; then
  echo "$STAGED_CODE" | xargs npx biome lint --no-errors-on-unmatched
fi

# The docs gate only when a CLAUDE.md / FEATURES.md is staged — it reads the whole repo
# but depends only on the docs, which are stable between sessions.
if git diff --cached --name-only | grep -qE "(CLAUDE|FEATURES)\.md$"; then
  pnpm -s check:docs
fi
