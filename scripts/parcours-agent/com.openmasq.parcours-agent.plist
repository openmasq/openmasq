<?xml version="1.0" encoding="UTF-8"?>
<!--
  Le déclencheur des sessions autonomes. À poser dans ~/Library/LaunchAgents/ puis
  `launchctl bootstrap gui/$(id -u) <ce fichier>`.

  ⚠️ LaunchAgent (gui/…), jamais LaunchDaemon : le pilote ouvre une VRAIE fenêtre Electron,
  ce qui exige la session graphique de l'utilisateur. Un daemon système tournerait sans
  écran et rendrait des fenêtres noires — donc des captures qui ressemblent à des bugs.

  Deux heures : assez pour qu'une session complète (build + parcours + correction +
  vérification) tienne largement, et assez rare pour qu'on ne découvre pas vingt PR le matin.
  Le vrai frein reste `~/.openmasq-agent/PAUSE`, qui coupe sans toucher à launchd.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openmasq.parcours-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/openmasq/redact/scripts/parcours-agent/run.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>7200</integer>

  <!-- Surtout PAS au chargement : un `launchctl bootstrap` déclencherait une session
       immédiate, en plein milieu d'autre chose. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/openmasq-parcours-agent.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/openmasq-parcours-agent.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
