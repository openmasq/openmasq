{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "32",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Docs and tests are not bundle inputs: hashing them would rebuild a package (and
      // everything downstream) for a markdown edit. Tests stay in `typecheck`'s inputs.
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts", "!**/*.test.tsx"],
      // Every artifact a task writes, or turbo cannot restore it and re-runs it every time.
      "outputs": ["dist/**", "out/**"],
      // Every variable BAKED into a bundle: two values sharing one cache entry would hand
      // back a bundle built for the other.
      "env": [
        "VITE_BACKEND_URL",
        "VITE_ADMIN_URL",
        "VITE_UPDATES_URL",
        "VITE_UPDATES_CHANNEL",
        "VITE_REDACT_FN_URL",
        "VITE_BACKEND_BYPASS",
        "VITE_ANALYTICS_RELAY_URL",
        "VITE_APP_VERSION"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // No `^build`: `tsconfig.workspace.json` points every `@openmasq/*` specifier at its
    // SOURCE, so a typecheck reads the code in front of you, never a stale `dist/*.d.ts`.
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "../../tsconfig.workspace.json"]
    },
    // The two `NodeNext` apps cannot compile the packages' Bundler-style sources, so they
    // check against `dist/*.d.ts` under a separate task that keeps the build dependency.
    "typecheck:built": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
