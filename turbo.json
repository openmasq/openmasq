{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "32",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Sans `inputs`, turbo hache TOUT le paquet — or la règle 5 impose d'éditer le
      // `CLAUDE.md` dans le même changement, donc chaque commit invalidait le build du
      // paquet ET de tout son aval pour un markdown que `tsup` ne lit jamais (mesuré :
      // une ligne ajoutée à `packages/redact/CLAUDE.md` coûtait 2 min 14 de rebuild).
      // Les tests sortent aussi : ils ne sont pas des points d'entrée de bundle. Ils
      // restent dans les `inputs` de `typecheck`, lui les vérifie pour de bon.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      // ⚠️ Un `outputs` qui rate les artefacts d'une tâche la rend NON RESTITUABLE : turbo
      // met le log en cache, pas le résultat, et la relance en entier à chaque fois (il le
      // dit — « no output files found for task … »). C'était le cas des deux apps Next
      // (`ops`, `docs` ; `web` est passée à Vite → `dist/**`, `landing` a quitté ce monorepo
      // le 18/08). `.next/cache/**` est exclu : c'est le cache interne de
      // Next, qu'il gère lui-même et qui pèse plus lourd que la sortie.
      // `@openmasq/backend#build` est un `tsc --noEmit` — il n'a vraiment aucune sortie.
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"],
      // ⚠️ TOUTE variable bakée dans le bundle appartient à cette liste, sinon deux
      // valeurs différentes partagent une entrée de cache et turbo REND un bundle bâti
      // avec l'autre — un binaire qui parle à la mauvaise origine, sans qu'aucune étape
      // ne l'annonce. Ces quatre-là manquaient alors que `release.yml` les passe : c'est
      // l'URL de redaction (un manque = « Failed to fetch ») et le contournement de la
      // protection Vercel du staging qui pouvaient sauter d'un build à l'autre.
      "env": [
        "VITE_BACKEND_URL",
        "VITE_ADMIN_URL",
        "VITE_UPDATES_URL",
        "VITE_UPDATES_CHANNEL",
        "VITE_REDACT_FN_URL",
        "VITE_BACKEND_BYPASS",
        "VITE_ANALYTICS_RELAY_URL",
        "VITE_ANALYTICS_APP_KEY",
        // Bakée elle aussi (`electron.vite.config.ts` en fait un `define`), donc soumise à
        // la même règle que les URL ci-dessus. Elle manquait : deux versions du MÊME code
        // partageaient une entrée, et un build local restituait le bundle de la version
        // précédente — le renderer annonçait alors à PostHog et Sentry une version qui
        // n'est pas celle de l'app installée, précisément le désalignement que
        // `src/sentry/policy.test.ts` veille à empêcher côté CI. Invisible en CI (le job
        // de release ne restaure aucun cache turbo), mortel sur une release faite depuis
        // une machine, où le cache est partagé avec tous les autres builds.
        "VITE_APP_VERSION"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      // `^build` est nécessaire : seul `apps/desktop` alias les paquets vers `src` par
      // ses `paths` (parité tenue par `pnpm check:alias`) ; partout ailleurs `tsc`
      // résout par node_modules, donc par les `dist/*.d.ts`.
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
