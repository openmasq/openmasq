{
  "name": "openmasq",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Desktop chat app for talking to multiple LLM models",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "node scripts/tooling/turbo.mjs run dev",
    "build": "node scripts/tooling/turbo.mjs run build",
    "typecheck": "node scripts/tooling/turbo.mjs run typecheck",
    "typecheck:built": "node scripts/tooling/turbo.mjs run typecheck:built",
    "lint": "node scripts/tooling/turbo.mjs run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:quiet": "VITEST_QUIET=1 vitest run",
    "test:pure": "VITEST_SCOPE=pure VITEST_NO_ISOLATE=1 vitest run --no-isolate",
    "test:apps": "VITEST_SCOPE=apps vitest run",
    "test:redact": "VITEST_NO_ISOLATE=1 vitest run packages/redact --no-isolate",
    "test:e2e": "pnpm --filter @openmasq/desktop run e2e",
    "eval": "vitest run --config vitest.evals.config.ts",
    "bench": "tsx scripts/tooling/bench-agentic.ts",
    "bench:compare": "tsx packages/redact/bench/compare.mts",
    "bench:spans": "tsx packages/redact/bench/spans/run.mts",
    "bench:latency": "tsx packages/redact/bench/spans/latency.mts",
    "bench:proxy": "pnpm --filter @openmasq/proxy bench",
    "e2e:login": "pnpm --filter @openmasq/desktop run e2e:login",
    "audit:gate": "node scripts/checks/audit-gate.mjs",
    "format": "biome format --write .",
    "check:lint": "biome lint .",
    "check:loc": "node scripts/checks/check-file-size.mjs",
    "check:docs": "node scripts/checks/check-docs.mjs",
    "check:tests": "node scripts/checks/check-test-include.mjs",
    "check:alias": "node scripts/checks/check-alias-parity.mjs",
    "check:dup": "node scripts/checks/check-dup.mjs",
    "check:features": "node scripts/checks/check-features.mjs",
    "check:i18n": "node scripts/checks/check-i18n.mjs",
    "check:css": "node scripts/checks/check-css-families.mjs",
    "check:features-drift": "node scripts/checks/check-features-drift.mjs",
    "check:pkgtree": "node scripts/checks/check-packaged-tree.mjs",
    "clean": "node scripts/tooling/turbo.mjs run clean && rm -rf node_modules",
    "check:effects": "node scripts/checks/check-effect-returns.mjs",
    "check:actions": "node scripts/checks/check-actions-pinned.mjs",
    "check:shipped": "node scripts/checks/check-shipped-bundles.mjs",
    "check:shipped:all": "node scripts/checks/check-shipped-bundles.mjs --require-all",
    "verify": "pnpm check:brand && pnpm -r --if-present typecheck && pnpm test && pnpm check:lint && pnpm check:loc && pnpm check:docs && pnpm check:tests && pnpm check:alias && pnpm check:dup && pnpm check:features && pnpm check:i18n && pnpm check:css && pnpm check:pkgtree && pnpm check:actions && pnpm check:knip && pnpm check:effects && pnpm check:shipped && pnpm check:pii",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:knip": "node scripts/checks/check-knip.mjs",
    "check:pii": "node scripts/checks/check-pii.mjs",
    "check:brand": "node scripts/checks/check-brand.mjs",
    "check:redact-pack": "node scripts/checks/check-redact-pack.mjs",
    "claude:sandbox": "bash scripts/tooling/claude-sandbox.sh",
    "test:corpus": "vitest run --config vitest.corpus.config.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@electron/asar": "^3.4.1",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "onnxruntime-node": "link:packages/ort",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "win32",
        "linux"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    },
    "overrides": {
      "path-to-regexp@<1": "0.1.13",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "undici@<6.29.1": "^6.29.1",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "qs@<6.16.1": "^6.16.1",
      "fast-uri@<3.1.9": "^3.1.9",
      "hono@<4.13.11": "^4.13.11",
      "@hono/node-server@<2.1.3": "^2.1.3",
      "ip-address@<10.7.4": "^10.7.4",
      "postcss@<8.5.23": "^8.5.23",
      "proxy-addr@<2.0.8": "^2.0.8",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "adm-zip@<0.6.1": "^0.6.1",
      "browserslist@<4.28.7": "^4.28.7",
      "brace-expansion@<1.1.21": "^1.1.21",
      "katex@<0.18.2": "^0.18.2",
      "launch-editor@<2.14.2": "^2.14.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "sharp@<0.35.5": "^0.35.5",
      "smol-toml@<1.9.0": "^1.9.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "tar@<7.5.21": "^7.5.21",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "onnxruntime-node": "link:packages/ort"
    }
  }
}
